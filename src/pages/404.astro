---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page not found | ${SITE_TITLE}`} description="This page could not be found." />
		<style>
			.notfound { padding: 5rem 0 4rem; }
			.notfound .code {
				font-family: 'IBM Plex Mono', monospace;
				font-size: 0.82rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--brand);
				margin: 0;
			}
			.notfound h1 {
				font-weight: 700;
				font-size: clamp(2.4rem, 6vw, 3.4rem);
				line-height: 1.05;
				letter-spacing: -0.02em;
				color: var(--ink);
				margin: 0.6rem 0 0.9rem;
			}
			.notfound p.lede { color: var(--muted); max-width: 52ch; margin: 0 0 1.8rem; }
			.notfound .links {
				display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem;
				font-family: 'IBM Plex Mono', monospace;
				font-size: 0.85rem;
			}
			.notfound .links a {
				color: var(--ink-soft); text-decoration: none;
				display: inline-flex; align-items: center; gap: 0.4rem;
				border-bottom: 1px solid transparent; padding-bottom: 2px;
				transition: color 0.15s, border-color 0.15s;
			}
			.notfound .links a:hover { color: var(--brand); border-bottom-color: var(--brand); }
		</style>
	</head>
	<body>
		<Header />

		<main class="wrap">
			<section class="notfound">
				<p class="code">Error 404</p>
				<h1>Page not found</h1>
				<p class="lede">The page you're looking for doesn't exist or has moved. Let's get you back on track.</p>
				<div class="links">
					<a href="/">Home</a>
					<a href="/research/">Research</a>
					<a href="/teaching/">Teaching</a>
					<a href="/about/">About</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
