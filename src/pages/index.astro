---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

// Toute la recherche, triée par date décroissante
const researchPosts = await getCollection('research');
const sortedResearch = researchPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const thesis = sortedResearch.filter(post => post.data.type === 'thesis');
const papers = sortedResearch.filter(post => post.data.type === 'paper');
const proceedings = sortedResearch.filter(post => post.data.type === 'proceeding');
const talks = sortedResearch.filter(post => post.data.type === 'talk' || post.data.type === 'poster');

const typeLabel = {
	paper: 'Journal',
	proceeding: 'Proceeding',
	talk: 'Talk',
	poster: 'Poster',
	thesis: 'Thesis',
};

const personLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Victor Bertret',
	url: 'https://vbertret.github.io',
	jobTitle: 'AI & Control Engineer',
	description: 'PhD in Applied Mathematics. Machine learning and stochastic control for real industrial systems.',
	alumniOf: { '@type': 'CollegeOrUniversity', name: 'Université de Rennes' },
	worksFor: { '@type': 'Organization', name: 'Purecontrol', url: 'https://www.purecontrol.com' },
	sameAs: [
		'https://github.com/vbertret',
		'https://www.linkedin.com/in/victor-bertret/',
		'https://x.com/VictorBertret',
		'https://scholar.google.com/citations?user=1yyIR1IAAAAJ&hl=fr',
		'https://cv.hal.science/victor-bertret',
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
			<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
		<style>
			/* ---------- HERO ---------- */
			.hero { padding: 3.5rem 0 0; }
			.hero h1 {
				font-weight: 700;
				font-size: clamp(2.4rem, 6vw, 3.4rem);
				line-height: 1.02;
				letter-spacing: -0.02em;
				color: var(--ink);
				margin: 0 0 0.9rem;
			}
			.hero .tagline {
				font-family: 'Space Grotesk', sans-serif;
				font-weight: 500;
				font-size: clamp(1.15rem, 2.5vw, 1.4rem);
				line-height: 1.35;
				color: var(--ink);
				max-width: 34ch;
				margin: 0 0 1.4rem;
			}
			.hero .lede {
				font-size: 1.02rem;
				color: var(--muted);
				max-width: 60ch;
				margin: 0 0 1.6rem;
			}
			.hero .lede a { border-bottom: 1px solid var(--brand-tint); }
			.hero .lede a:hover { border-bottom-color: var(--brand); }

			.id-links {
				display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem;
				font-family: 'IBM Plex Mono', monospace;
				font-size: 0.82rem;
			}
			.id-links a {
				color: var(--ink-soft); text-decoration: none;
				display: inline-flex; align-items: center; gap: 0.4rem;
				border-bottom: 1px solid transparent; padding-bottom: 2px;
				transition: color 0.15s, border-color 0.15s;
			}
			.id-links a:hover { color: var(--brand); border-bottom-color: var(--brand); }
			.id-links .dot { color: var(--faint); }

			section.block { margin-top: 3rem; }
		</style>
	</head>
	<body>
		<Header />

		<main class="wrap">
			<section class="hero">
				<p class="eyebrow">AI &amp; Control · Applied Mathematics</p>
				<h1>Victor Bertret</h1>
				<p class="tagline">Machine learning &amp; stochastic control for real industrial systems.</p>
				<p class="lede">
					I design algorithms at the intersection of physical modeling, data assimilation and optimal
					control, and take them all the way to deployment on live plants at
					<a href="https://www.purecontrol.com" target="_blank">Purecontrol</a>. PhD in Applied
					Mathematics, Université de Rennes.
				</p>
				<div class="id-links">
					<a href="/research/">Research</a>
					<span class="dot">/</span>
					<a class="email-link" data-user="victor.bertret" data-domain="purecontrol.com" href="#">Email</a>
					<a href="https://github.com/vbertret" target="_blank">GitHub ↗</a>
					<a href="https://www.linkedin.com/in/victor-bertret/" target="_blank">LinkedIn ↗</a>
					<a href="https://scholar.google.com/citations?user=1yyIR1IAAAAJ&hl=fr" target="_blank">Scholar ↗</a>
					<a href="https://cv.hal.science/victor-bertret" target="_blank">HAL ↗</a>
				</div>
			</section>

			{papers.length > 0 && (
				<section class="block">
					<div class="sec-head">
						<h2>Journal Articles</h2>
						<span class="count">{String(papers.length).padStart(2, '0')}</span>
					</div>
					{papers.map((post) => (
						<a class="pub" href={`/research/${post.id}/`}>
							<span class="year">{post.data.pubDate.getFullYear()}</span>
							<div class="body">
								<h3 class="title">{post.data.title}</h3>
								<div class="meta">
									<span class="chip">{typeLabel[post.data.type]}</span>
									<span>{post.data.journal}</span>
								</div>
								{post.data.description && <p class="desc">{post.data.description}</p>}
							</div>
						</a>
					))}
				</section>
			)}

			{proceedings.length > 0 && (
				<section class="block">
					<div class="sec-head">
						<h2>Conference Proceedings</h2>
						<span class="count">{String(proceedings.length).padStart(2, '0')}</span>
					</div>
					{proceedings.map((post) => (
						<a class="pub" href={`/research/${post.id}/`}>
							<span class="year">{post.data.pubDate.getFullYear()}</span>
							<div class="body">
								<h3 class="title">{post.data.title}</h3>
								<div class="meta">
									<span class="chip proceeding">Proceeding</span>
									<span>{post.data.event}</span>
									<span class="arrow">→</span>
								</div>
							</div>
						</a>
					))}
				</section>
			)}

			{talks.length > 0 && (
				<section class="block">
					<div class="sec-head">
						<h2>Talks &amp; Posters</h2>
						<span class="count">{String(talks.length).padStart(2, '0')}</span>
					</div>
					{talks.map((post) => (
						<a class="pub" href={`/research/${post.id}/`}>
							<span class="year">{post.data.pubDate.getFullYear()}</span>
							<div class="body">
								<h3 class="title">{post.data.title}</h3>
								<div class="meta">
									<span class={`chip ${post.data.type}`}>{typeLabel[post.data.type]}</span>
									<span>{post.data.event}</span>
									<span class="arrow">→</span>
								</div>
							</div>
						</a>
					))}
				</section>
			)}

			{thesis.length > 0 && (
				<section class="block">
					<div class="sec-head">
						<h2>PhD Thesis</h2>
						<span class="count">{String(thesis.length).padStart(2, '0')}</span>
					</div>
					{thesis.map((post) => (
						<a class="pub" href={`/research/${post.id}/`}>
							<span class="year">{post.data.pubDate.getFullYear()}</span>
							<div class="body">
								<h3 class="title">{post.data.title}</h3>
								<div class="meta">
									<span class="chip thesis">Thesis</span>
									<span>{post.data.journal}</span>
								</div>
								{post.data.description && <p class="desc">{post.data.description}</p>}
							</div>
						</a>
					))}
				</section>
			)}
		</main>

		<Footer />
	</body>
</html>
