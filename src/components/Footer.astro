	</div>
</footer>

<script is:inline>
	// Assemble email addresses at runtime so the raw address is never in the static HTML (spam-bot protection).
	document.querySelectorAll('.email-link').forEach(function (a) {
		var addr = a.getAttribute('data-user') + '@' + a.getAttribute('data-domain');
		a.setAttribute('href', 'mailto:' + addr); // clickable, but the visible "[at]" text is left as-is
	});
</script>

<style>
	footer {
		margin-top: 4rem;
		padding: 2rem 1.25rem 3rem;
		border-top: 1px solid var(--line);
		background: var(--wash);
	}
	.foot-inner {
		max-width: var(--content);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.copy {
		font-family: 'IBM Plex Mono', monospace;
		font-size: 0.8rem;
		color: var(--muted);
	}
	.social-links {
		display: flex;
		gap: 0.9rem;
	}
	.social-links a {
		text-decoration: none;
		color: var(--faint);
		display: flex;
		transition: color 0.15s;
	}
	.social-links a:hover {
		color: var(--brand);
	}
	.social-links svg {
		width: 20px;
		height: 20px;
	}
	@media (max-width: 480px) {
		.foot-inner { flex-direction: column; align-items: flex-start; }
	}
</style>
