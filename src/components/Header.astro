---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---
<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/research">Research</HeaderLink>
        	<HeaderLink href="/teaching">Teaching</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="nav-right">
			<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">
				<svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
				</svg>
				<svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
			</button>
			<div class="social-links">
			<a href="https://github.com/vbertret" target="_blank">
				<span class="sr-only">Victor Bertret on GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a href="https://www.linkedin.com/in/victor-bertret/" target="_blank">
				<span class="sr-only">Victor Bertret on LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
					></path></svg
				>
			</a>
			<a href="https://scholar.google.com/citations?user=1yyIR1IAAAAJ&hl=fr" target="_blank">
				<span class="sr-only">Victor Bertret on Google Scholar</span>
				<svg viewBox="0 0 512 512" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M256 32 20 160l236 128 236-128zM88 224v92c0 37 75 68 168 68s168-31 168-68v-92l-168 91z"
					></path></svg
				>
			</a>
			<a href="https://x.com/VictorBertret" target="_blank">
				<span class="sr-only">Victor Bertret on X (Twitter)</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M9.294 6.928 14.357 1h-1.2L8.762 6.147 5.25 1H1.2l5.31 7.784L1.2 15h1.2l4.642-5.436L10.75 15h4.05L9.294 6.928zM7.651 8.852l-.538-.775L2.832 1.91h1.843l3.454 4.977.538.775 4.49 6.47h-1.843l-3.66-5.27z"
					></path></svg
				>
			</a>
			</div>
		</div>
	</nav>
</header>

<script is:inline>
	(function () {
		var btn = document.getElementById('theme-toggle');
		if (!btn) return;
		btn.addEventListener('click', function () {
			var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
			document.documentElement.setAttribute('data-theme', next);
			try { localStorage.setItem('theme', next); } catch (e) {}
		});
	})();
</script>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		margin: 0;
		padding: 0 1.25em;
		background: var(--header-bg, rgba(255, 255, 255, 0.82));
		backdrop-filter: saturate(180%) blur(12px);
		-webkit-backdrop-filter: saturate(180%) blur(12px);
		border-bottom: 1px solid var(--line, #e6ecec);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 760px;
		margin: 0 auto;
		min-height: 3.6rem;
	}
	h2 {
		margin: 0;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 1.02rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	h2 a {
		text-decoration: none;
		color: var(--ink, #111820);
	}
	.internal-links {
		display: flex;
		gap: 0.25rem;
	}
	nav a {
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 0.92rem;
		font-weight: 500;
		padding: 0.4rem 0.7rem;
		color: var(--muted, #67727f);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		border-radius: 6px;
		transition: color 0.15s, background 0.15s;
	}
	.internal-links a:hover {
		color: var(--ink, #111820);
		background: var(--wash, #f4f8f7);
	}
	nav a.active {
		color: var(--brand, #0e6b6b);
		border-bottom-color: var(--brand, #0e6b6b);
		border-radius: 0;
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		padding: 0;
		border: 1px solid var(--line, #e6ecec);
		border-radius: 8px;
		background: transparent;
		color: var(--muted, #67727f);
		cursor: pointer;
		transition: color 0.15s, border-color 0.15s, background 0.15s;
	}
	.theme-toggle:hover {
		color: var(--brand, #0e6b6b);
		border-color: var(--brand, #0e6b6b);
		background: var(--wash, #f4f8f7);
	}
	.theme-toggle .icon-moon { display: none; }
	:global([data-theme='dark']) .theme-toggle .icon-sun { display: none; }
	:global([data-theme='dark']) .theme-toggle .icon-moon { display: block; }
	.social-links {
		display: flex;
		gap: 0.35rem;
	}
	.social-links a {
		display: flex;
		align-items: center;
		padding: 0.3rem;
		color: var(--muted, #67727f);
		transition: color 0.15s;
	}
	.social-links a:hover {
		color: var(--brand, #0e6b6b);
	}
	.social-links svg {
		width: 20px;
		height: 20px;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		h2 {
			font-size: 0.95rem;
		}
	}
	@media (max-width: 520px) {
		header { padding: 0 0.6em; }
		nav { min-height: 3.2rem; }
		h2 { font-size: 0.85rem; }
		nav a { padding: 0.4rem 0.4rem; font-size: 0.82rem; }
		.internal-links { gap: 0; }
		.nav-right { gap: 0.3rem; }
	}
</style>
